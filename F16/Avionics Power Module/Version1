// =====================================================
// F-16C AVIONICS POWER panel
// ESP32-S3 Waveshare ETH PoE + W5500
// DHCP, automatic DCS-LINK discovery and live module status
//
// In Avionicscraft Simulator Software select Output mode = DCS-BIOS.
// =====================================================

#include <SPI.h>
#include <Ethernet.h>
#include <EthernetUdp.h>

namespace DcsBios {
  bool tryToSendDcsBiosMessage(const char* msg, const char* arg);
}

#include <DcsBios.h>

// W5500 pins
#define W5500_CS    14
#define W5500_SCK   13
#define W5500_MISO  12
#define W5500_MOSI  11
#define W5500_RST   9

#define STRINGIFY_VALUE_INNER(value) #value
#define STRINGIFY_VALUE(value) STRINGIFY_VALUE_INNER(value)

// Panel backlight PWM output
#define LED_PIN 43
const int PWM_FREQUENCY = 5000;
const int PWM_RESOLUTION = 8;
// The installed LED driver uses a normal active-high PWM control input.
const bool LED_OUTPUT_INVERTED = false;

// Avionics Power switches. All switch common terminals go to GND.
#define MMC_ON_PIN       48  // J2
#define ST_STA_ON_PIN    47  // J4
#define MFD_ON_PIN       46  // J6
#define UFC_ON_PIN       45  // J8
#define GPS_ON_PIN       42  // J10
#define DL_ON_PIN        41  // J12

// Six-position INS rotary. DCS also has CAL between NAV and IN FLT ALIGN;
// this panel deliberately skips CAL, so the last two positions map to 5 and 6.
#define INS_OFF_PIN       40  // J14
#define INS_STOR_HDG_PIN  39  // J15
#define INS_NORM_PIN      38  // J16
#define INS_NAV_PIN       37  // J17
#define INS_FLT_ALIGN_PIN 36  // J18
#define INS_ATT_PIN       35  // J19

// Unique identity for this module.
byte mac[] = { 0x02, 0x4A, 0x83, 0x5C, 0xF7, 0x62 };
const char PANEL_NAME[] = "F16 Avionics Power";
const char AIRCRAFT_NAME[] = "F-16C";
const char MODULE_NAME[] = "Avionics Power";

// Text shown in the Component column of Avionicscraft Simulator Software.
// Change these labels freely; keep the DCS-BIOS control names unchanged.
const char LABEL_MMC_POWER[] = "Modular mission computer power switch";
const char LABEL_ST_STA_POWER[] = "Station status power switch";
const char LABEL_MFD_POWER[] = "Multi-function display power switch";
const char LABEL_UFC_POWER[] = "Up-front controls power switch";
const char LABEL_GPS_POWER[] = "GPS power switch";
const char LABEL_DL_POWER[] = "Data link power switch";
const char LABEL_INS_MODE[] = "INS mode selector";
const char LABEL_LED_BRIGHTNESS[] = "Panel LED brightness (GPIO 43)";
const char LABEL_LED_TEST[] = "LED test";

// Physical label or connector reference shown by the software.
// Change these values to the label numbers used on your panel.
const char LABEL_NO_MMC_POWER[] = "J2";
const char LABEL_NO_ST_STA_POWER[] = "J4";
const char LABEL_NO_MFD_POWER[] = "J6";
const char LABEL_NO_UFC_POWER[] = "J8";
const char LABEL_NO_GPS_POWER[] = "J10";
const char LABEL_NO_DL_POWER[] = "J12";
const char LABEL_NO_INS_MODE[] = "J14 / J15 / J16 / J17 / J18 / J19";
const char LABEL_NO_LED_BRIGHTNESS[] = "J0";
const char LABEL_NO_LED_TEST[] = "TEST";

// Must match Avionicscraft Simulator Software.
const uint16_t DCS_LINK_DISCOVERY_PORT = 39000;
const uint16_t LOCAL_UDP_PORT = 39002;
const uint16_t DEFAULT_PANEL_PORT = 39001;

EthernetClient client;
EthernetUDP discoveryUdp;
DcsBios::ProtocolParser parser;

IPAddress dcsLinkIp(0, 0, 0, 0);
uint16_t dcsLinkPort = DEFAULT_PANEL_PORT;

bool ethernetOk = false;
bool telemetryPending = true;
bool ledTestActive = false;
unsigned long lastDhcpRetry = 0;
unsigned long lastDiscovery = 0;
unsigned long lastDhcpMaintain = 0;
unsigned long lastTelemetryTime = 0;
unsigned long lastLedTestCommand = 0;
int currentLedPwm = 0;

const unsigned long SWITCH_DEBOUNCE_MS = 35;

struct ToggleSwitch {
  const char* controlName;
  const char* displayName;
  const char* pinNumber;
  const char* labelNumber;
  uint8_t pin;
  int stableState;
  int sampledState;
  unsigned long sampledAt;
};

ToggleSwitch toggleSwitches[] = {
  { "MMC_PWR_SW", LABEL_MMC_POWER, STRINGIFY_VALUE(MMC_ON_PIN), LABEL_NO_MMC_POWER, MMC_ON_PIN, 0, 0, 0 },
  { "ST_STA_SW", LABEL_ST_STA_POWER, STRINGIFY_VALUE(ST_STA_ON_PIN), LABEL_NO_ST_STA_POWER, ST_STA_ON_PIN, 0, 0, 0 },
  { "MFD_SW", LABEL_MFD_POWER, STRINGIFY_VALUE(MFD_ON_PIN), LABEL_NO_MFD_POWER, MFD_ON_PIN, 0, 0, 0 },
  { "UFC_SW", LABEL_UFC_POWER, STRINGIFY_VALUE(UFC_ON_PIN), LABEL_NO_UFC_POWER, UFC_ON_PIN, 0, 0, 0 },
  { "GPS_SW", LABEL_GPS_POWER, STRINGIFY_VALUE(GPS_ON_PIN), LABEL_NO_GPS_POWER, GPS_ON_PIN, 0, 0, 0 },
  { "DL_SW", LABEL_DL_POWER, STRINGIFY_VALUE(DL_ON_PIN), LABEL_NO_DL_POWER, DL_ON_PIN, 0, 0, 0 }
};

const size_t TOGGLE_SWITCH_COUNT = sizeof(toggleSwitches) / sizeof(toggleSwitches[0]);

const uint8_t insPins[] = {
  INS_OFF_PIN,
  INS_STOR_HDG_PIN,
  INS_NORM_PIN,
  INS_NAV_PIN,
  INS_FLT_ALIGN_PIN,
  INS_ATT_PIN
};
const int insDcsStates[] = { 0, 1, 2, 3, 5, 6 };
const char* const insStateNames[] = { "OFF", "STOR HDG", "NORM", "NAV", "IN FLT ALIGN", "ATT" };
const size_t INS_POSITION_COUNT = sizeof(insPins) / sizeof(insPins[0]);

int stableInsIndex = 0;
int sampledInsIndex = 0;
unsigned long sampledInsAt = 0;

// =====================================================
// DCS-BIOS transport
// =====================================================

namespace DcsBios {
  bool tryToSendDcsBiosMessage(const char* msg, const char* arg) {
    if (!client.connected()) return false;
    if (client.print(msg) == 0) {
      client.stop();
      return false;
    }
    client.print(' ');
    client.print(arg);
    client.print('\n');
    return true;
  }
}

void onDcsBiosWrite(unsigned int address, unsigned int value) {
}

void writeLedBrightness(int brightness) {
  brightness = constrain(brightness, 0, 255);
  ledcWrite(LED_PIN, LED_OUTPUT_INVERTED ? 255 - brightness : brightness);
}

void onPriConsolesBrtKnbChange(unsigned int value) {
  currentLedPwm = constrain(map(value, 0, 65535, 0, 255), 0, 255);
  if (!ledTestActive) writeLedBrightness(currentLedPwm);
}

DcsBios::IntegerBuffer priConsolesBrtKnbBuffer(
  F_16C_50_PRI_CONSOLES_BRT_KNB,
  onPriConsolesBrtKnbChange
);

// =====================================================
// Switch handling
// =====================================================

int readToggleSwitch(const ToggleSwitch& toggleSwitch) {
  return digitalRead(toggleSwitch.pin) == LOW ? 1 : 0;
}

void sendToggleToDcs(const ToggleSwitch& toggleSwitch) {
  char valueText[4];
  snprintf(valueText, sizeof(valueText), "%d", toggleSwitch.stableState);
  DcsBios::tryToSendDcsBiosMessage(toggleSwitch.controlName, valueText);
}

void initializeSwitches() {
  for (size_t index = 0; index < TOGGLE_SWITCH_COUNT; index++) {
    ToggleSwitch& toggleSwitch = toggleSwitches[index];
    pinMode(toggleSwitch.pin, INPUT_PULLUP);
    toggleSwitch.stableState = readToggleSwitch(toggleSwitch);
    toggleSwitch.sampledState = toggleSwitch.stableState;
    toggleSwitch.sampledAt = millis();
  }

  for (size_t index = 0; index < INS_POSITION_COUNT; index++) {
    pinMode(insPins[index], INPUT_PULLUP);
  }

  stableInsIndex = 0;
  for (size_t index = 0; index < INS_POSITION_COUNT; index++) {
    if (digitalRead(insPins[index]) == LOW) stableInsIndex = (int)index;
  }
  sampledInsIndex = stableInsIndex;
  sampledInsAt = millis();
}

int readInsIndex() {
  int selectedIndex = -1;
  for (size_t index = 0; index < INS_POSITION_COUNT; index++) {
    if (digitalRead(insPins[index]) != LOW) continue;
    if (selectedIndex >= 0) return stableInsIndex;
    selectedIndex = (int)index;
  }
  return selectedIndex >= 0 ? selectedIndex : stableInsIndex;
}

void sendInsToDcs() {
  char valueText[4];
  snprintf(valueText, sizeof(valueText), "%d", insDcsStates[stableInsIndex]);
  DcsBios::tryToSendDcsBiosMessage("INS_KNB", valueText);
}

void pollSwitches() {
  unsigned long now = millis();
  for (size_t index = 0; index < TOGGLE_SWITCH_COUNT; index++) {
    ToggleSwitch& toggleSwitch = toggleSwitches[index];
    int state = readToggleSwitch(toggleSwitch);

    if (state != toggleSwitch.sampledState) {
      toggleSwitch.sampledState = state;
      toggleSwitch.sampledAt = now;
    }

    if (state != toggleSwitch.stableState && now - toggleSwitch.sampledAt >= SWITCH_DEBOUNCE_MS) {
      toggleSwitch.stableState = state;
      sendToggleToDcs(toggleSwitch);
      telemetryPending = true;
    }
  }

  int insIndex = readInsIndex();
  if (insIndex != sampledInsIndex) {
    sampledInsIndex = insIndex;
    sampledInsAt = now;
  }
  if (insIndex != stableInsIndex && now - sampledInsAt >= SWITCH_DEBOUNCE_MS) {
    stableInsIndex = insIndex;
    sendInsToDcs();
    telemetryPending = true;
  }
}

void sendAllSwitchesToDcs() {
  for (size_t index = 0; index < TOGGLE_SWITCH_COUNT; index++) {
    sendToggleToDcs(toggleSwitches[index]);
  }
  sendInsToDcs();
}

// =====================================================
// Live module status
// =====================================================

void sendPanelTelemetry() {
  if (!client.connected()) return;
  for (size_t index = 0; index < TOGGLE_SWITCH_COUNT; index++) {
    client.print("PANEL_STATE|");
    client.print(toggleSwitches[index].controlName);
    client.print('|');
    client.print(toggleSwitches[index].stableState == 1 ? "ON" : "OFF");
    client.print('|');
    client.print(toggleSwitches[index].displayName);
    client.print("|INPUT|");
    client.print(toggleSwitches[index].pinNumber);
    client.print('|');
    client.println(toggleSwitches[index].labelNumber);
  }

  client.print("PANEL_STATE|INS_KNB|");
  client.print(insStateNames[stableInsIndex]);
  client.print('|'); client.print(LABEL_INS_MODE);
  client.print("|INPUT|40 / 39 / 38 / 37 / 36 / 35|");
  client.println(LABEL_NO_INS_MODE);

  client.print("PANEL_STATE|LED_PWM_GPIO43|");
  client.print(ledTestActive ? 255 : currentLedPwm);
  client.print('|'); client.print(LABEL_LED_BRIGHTNESS);
  client.print("|OUTPUT|"); client.print(STRINGIFY_VALUE(LED_PIN));
  client.print('|'); client.println(LABEL_NO_LED_BRIGHTNESS);
  client.print("PANEL_STATE|LED_TEST_ACTIVE|");
  client.print(ledTestActive ? 1 : 0);
  client.print('|'); client.print(LABEL_LED_TEST);
  client.print("|COMMAND|-|"); client.println(LABEL_NO_LED_TEST);
}

void handleLedTestCommands() {
  int packetSize;
  while ((packetSize = discoveryUdp.parsePacket()) > 0) {
    char message[32];
    int length = discoveryUdp.read(message, min(packetSize, (int)sizeof(message) - 1));
    message[length] = '\0';
    if (!client.connected() || discoveryUdp.remoteIP() != dcsLinkIp) continue;

    int enabled;
    if (sscanf(message, "PANEL_LED_TEST|%d", &enabled) != 1 || (enabled != 0 && enabled != 1)) continue;
    ledTestActive = enabled == 1;
    lastLedTestCommand = millis();
    writeLedBrightness(ledTestActive ? 255 : currentLedPwm);
    telemetryPending = true;
  }

  // Restore the DCS-controlled value if a button-release packet is lost.
  if (ledTestActive && millis() - lastLedTestCommand > 800) {
    ledTestActive = false;
    writeLedBrightness(currentLedPwm);
    telemetryPending = true;
  }
}

// =====================================================
// Ethernet and DCS-LINK discovery
// =====================================================

void macToText(char* output, size_t outputSize) {
  snprintf(output, outputSize, "%02X:%02X:%02X:%02X:%02X:%02X",
    mac[0], mac[1], mac[2], mac[3], mac[4], mac[5]);
}

void resetW5500() {
  pinMode(W5500_RST, OUTPUT);
  digitalWrite(W5500_RST, LOW);
  delay(300);
  digitalWrite(W5500_RST, HIGH);
  delay(1000);
}

void startEthernet() {
  SPI.begin(W5500_SCK, W5500_MISO, W5500_MOSI, W5500_CS);
  SPI.setFrequency(8000000);
  Ethernet.init(W5500_CS);

  Serial.println("Requesting DHCP address...");
  if (Ethernet.begin(mac) == 0) {
    ethernetOk = false;
    Serial.println("DHCP failed.");
    return;
  }

  ethernetOk = true;
  dcsLinkIp = IPAddress(0, 0, 0, 0);
  discoveryUdp.stop();
  discoveryUdp.begin(LOCAL_UDP_PORT);
  Serial.print("DHCP address: ");
  Serial.println(Ethernet.localIP());
}

void discoverDcsLink() {
  char macText[18];
  char request[104];
  macToText(macText, sizeof(macText));
  snprintf(request, sizeof(request), "DCS_PANEL_DISCOVER|%s|%s\n", macText, PANEL_NAME);

  discoveryUdp.beginPacket(IPAddress(255, 255, 255, 255), DCS_LINK_DISCOVERY_PORT);
  discoveryUdp.write((const uint8_t*)request, strlen(request));
  discoveryUdp.endPacket();

  unsigned long started = millis();
  while (millis() - started < 250) {
    int packetLength = discoveryUdp.parsePacket();
    if (packetLength <= 0) {
      delay(2);
      continue;
    }

    char response[48];
    int bytesToRead = min(packetLength, (int)sizeof(response) - 1);
    int bytesRead = discoveryUdp.read(response, bytesToRead);
    response[bytesRead] = '\0';

    int port = 0;
    if (sscanf(response, "DCS_PANEL_HUB|%d", &port) == 1 && port > 0 && port < 65536) {
      dcsLinkIp = discoveryUdp.remoteIP();
      dcsLinkPort = (uint16_t)port;
      Serial.print("DCS-LINK found: ");
      Serial.print(dcsLinkIp);
      Serial.print(':');
      Serial.println(dcsLinkPort);
      return;
    }
  }
}

void connectToDcsLink() {
  if (client.connected() || dcsLinkIp == IPAddress(0, 0, 0, 0)) return;

  client.stop();
  client.setTimeout(100);
  if (!client.connect(dcsLinkIp, dcsLinkPort)) {
    Serial.println("DCS-LINK connection failed.");
    return;
  }

  char macText[18];
  char hello[104];
  macToText(macText, sizeof(macText));
  snprintf(hello, sizeof(hello), "DCS_PANEL_HELLO|%s|%s|%s\n", macText, AIRCRAFT_NAME, MODULE_NAME);
  client.print(hello);

  sendAllSwitchesToDcs();
  telemetryPending = true;
  Serial.println("Connected to DCS-LINK.");
}

// =====================================================
// Setup and main loop
// =====================================================

void setup() {
  Serial.begin(115200);
  delay(1000);
  Serial.println("F16 Avionics Power panel starting.");

  initializeSwitches();
  ledcAttach(LED_PIN, PWM_FREQUENCY, PWM_RESOLUTION);
  writeLedBrightness(0);
  resetW5500();
  startEthernet();
}

void loop() {
  unsigned long now = millis();

  pollSwitches();

  if (!ethernetOk) {
    if (now - lastDhcpRetry >= 10000) {
      lastDhcpRetry = now;
      startEthernet();
    }
    delay(10);
    return;
  }

  if (Ethernet.linkStatus() == LinkOFF) {
    client.stop();
    ledTestActive = false;
    writeLedBrightness(currentLedPwm);
    delay(100);
    return;
  }

  if (now - lastDhcpMaintain >= 60000) {
    Ethernet.maintain();
    lastDhcpMaintain = now;
  }

  handleLedTestCommands();

  if (!client.connected()) {
    if (now - lastDiscovery >= 1000) {
      lastDiscovery = now;
      discoverDcsLink();
      connectToDcsLink();
    }
  } else {
    int readLimit = 256;
    while (client.available() && readLimit--) {
      int input = client.read();
      if (input < 0) break;
      parser.processChar((char)input);
      delayMicroseconds(20);
    }
  }

  DcsBios::PollingInput::pollInputs();
  DcsBios::ExportStreamListener::loopAll();

  if (client.connected() && (telemetryPending || millis() - lastTelemetryTime >= 100)) {
    sendPanelTelemetry();
    lastTelemetryTime = millis();
    telemetryPending = false;
  }

  delay(2);
}
